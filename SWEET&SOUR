}

.search{
width:180px;
padding:10px 15px;
border-radius:20px;
border:1px solid #494151;
background:#29242f;
color:white;
}

.hero{
background:linear-gradient(135deg,#17131c,#5b263d);
color:white;
padding:100px 7%;
}

.hero small{
letter-spacing:4px;
color:#e6b7c9;
font-weight:bold;
}

.hero h1{
font-size:72px;
margin:15px 0;
letter-spacing:3px;
}

.hero p{
color:#ddd;
max-width:650px;
font-size:17px;
line-height:1.7;
}

.info{
padding:60px 7%;
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
}

.info-box{
background:white;
padding:25px;
border-radius:18px;
box-shadow:0 8px 25px #211c2510;
}

.info-box span{
display:block;
font-size:11px;
font-weight:bold;
color:#9a4e70;
letter-spacing:2px;
margin-bottom:8px;
}

.info-box strong{ 
font-size:20px;
}

.members{
padding:20px 7% 80px;
}

.members h2{
font-size:35px;
margin-bottom:30px;
}

.member-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:25px;
}

.member{
background:white;
border-radius:20px;
overflow:hidden;
box-shadow:0 8px 25px #211c2510;
transition:.25s;
}

.member:hover{
transform:translateY(-6px);
}

.member img{
width:100%;
height:390px;
object-fit:cover;
display:block;
}

.member-info{
padding:20px;
}

.member-info h3{
font-size:25px;
margin-bottom:6px;
}

.position{
font-size:12px;
font-weight:bold;
color:#9a4e70;
letter-spacing:1px;
line-height:1.6;
}

footer{
background:#17131c;
color:#aaa;
padding:40px;
text-align:center;
}

@media(max-width:900px){
.info{
grid-template-columns:repeat(2,1fr);
}

.member-grid{
grid-template-columns:repeat(2,1fr);
}
}

@media(max-width:600px){
.info{
grid-template-columns:1fr;
}

.member-grid{
grid-template-columns:1fr;
}

.hero h1{
font-size:50px;
}
}
