}

header{
height:76px;
background:#17131c;
color:white;
display:flex;
align-items:center;
padding:0 6%;
gap:30px;
position:sticky;
top:0;
z-index:10;
}

.logo{
font-size:24px;
font-weight:900;
letter-spacing:2px;
}

nav{
margin-left:auto;
display:flex;
gap:22px;
